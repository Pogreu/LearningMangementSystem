<mxfile host="app.diagrams.net">
  <diagram name="Controller-Service-Repository-DB Cycle">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Nodes in circular layout -->

        <mxCell id="2" value="Controller"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="3" value="Service"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="4" value="Repository"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="1">
          <mxGeometry x="550" y="520" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="5" value="Database (PostgreSQL)"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges -->

        <mxCell id="6" edge="1" parent="1" source="2" target="3"
          style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="7" edge="1" parent="1" source="3" target="4"
          style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="8" edge="1" parent="1" source="4" target="5"
          style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Closing the loop back to Controller -->
        <mxCell id="9" edge="1" parent="1" source="5" target="2"
          style="endArrow=block;html=1;curved=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
